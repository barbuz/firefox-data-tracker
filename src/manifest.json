{
  "manifest_version": 3,
  "name": "Data Usage Tracker",
  "version": "1.5.0",
  "description": "Locally logs how much data each site downloads, with a filterable dashboard.",
  "icons": {
    "48": "icons/icon-48.png",
    "96": "icons/icon-96.png",
    "128": "icons/icon-128.png"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "data-usage-tracker@example.local",
      "strict_min_version": "140.0",
      "data_collection_permissions": {
        "required": ["none"]
      }
    },
    "gecko_android": {
      "strict_min_version": "142.0"
    }
  },
  "permissions": [
    "webRequest",
    "storage",
    "unlimitedStorage",
    "alarms"
  ],
  "optional_permissions": [
    "webRequestBlocking",
    "webRequestFilterResponse"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "scripts": ["background.js"],
    "type": "module"
  },
  "options_ui": {
    "page": "ui/dashboard.html",
    "open_in_tab": true
  },
  "action": {
    "default_title": "Data Usage Tracker",
    "default_popup": "ui/popup.html",
    "default_icon": {
      "16": "icons/action-16.png",
      "32": "icons/action-32.png",
      "48": "icons/action-48.png"
    }
  }
}
